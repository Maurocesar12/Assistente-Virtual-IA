{
  "name": "zapiens",
  "version": "1.1.0",
  "description": "WhatsApp AI Automation SaaS — Clean Architecture",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm",
    "start": "node --max-old-space-size=350 dist/index.js",
    "setup": "npm run prisma:generate",
    "lint": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema Back-End/prisma/schema.prisma",
    "postinstall": "prisma generate --schema Back-End/prisma/schema.prisma"
  },
  "keywords": [
    "whatsapp",
    "ai",
    "automation",
    "saas"
  ],
  "author": {
    "name": "Mauro César Guimaraes",
    "email": "mauroguima080@hotmail.com"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.2.1",
    "@prisma/client": "^6.19.2",
    "@wppconnect-team/wppconnect": "^1.41.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.1",
    "openai": "^4.24.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.8",
    "@types/nodemailer": "^7.0.11",
    "prisma": "^6.19.2",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
