# Database
DATABASE_URL="postgresql://usuario:senha@ep-seu-endpoint.neon.tech/neondb?sslmode=require"

# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000
# Use em producao: FRONTEND_URL=https://zapiens.netlify.app
# Opcional: CORS_ORIGINS=https://zapiens.netlify.app,https://outro-front.com

# Auth
JWT_SECRET=troque_por_uma_chave_segura_de_32_chars_minimo
JWT_EXPIRES_IN=7d
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=hex_de_64_caracteres

# Public API
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# AI Keys (opcionais - configuradas por usuario)
# OPENAI_KEY=sk-...
# OPENAI_ASSISTANT=asst_...
# GEMINI_KEY=AIza...

# SMTP (obrigatorio para recuperacao de senha)
# Gmail: ative "Senhas de app" em Google > Conta > Seguranca
#        Use a senha de 16 digitos gerada, nao sua senha normal
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="Zapiens <seuemail@gmail.com>"
